#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", File.dirname(__FILE__))
require 'smile'

if ARGV.empty?
  abort "Usage: #{File.basename($0)} FILE.smil"
end

path = ARGV[0]
unless File.file?(path)
  abort "#{File.basename($0)}: no such file: #{path}"
end

Smile.run(File.read(path))
